{
  "name": "employee-salary-backend",
  "version": "1.0.0",
  "description": "Employee Onboarding and Salary Management API built with NestJS and Prisma",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nestjs/common": "^12.4.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.1",
    "@nestjs/platform-express": "^12.4.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@nestjs/testing": "^12.5.0",
    "@swc/core-win32-x64-msvc": "^1.16.22",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.2",
    "prisma": "7.10.1",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^3.0.8"
  }
}
